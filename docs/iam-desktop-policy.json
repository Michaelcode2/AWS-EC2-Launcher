{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadEc2Inventory",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeTags",
        "ec2:DescribeInstanceStatus"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageApprovedInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances"
      ],
      "Resource": [
        "arn:aws:ec2:eu-central-1:123456789012:instance/i-0123456789abcdef0"
      ]
    }
  ]
}
